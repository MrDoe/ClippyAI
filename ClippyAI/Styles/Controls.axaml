<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Control styles for the ClippyAI design language.
        Tokens live in Styles/Theme.axaml; this file only turns them into
        component-level rules.

        Iconography: every icon in the app comes from the bundled
        Font Awesome 6 Free Solid face, so all icons share one weight, one
        optical size and one grid. Emoji are never used as icons.
    -->

    <!-- ============================ Typography ================================= -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeBody}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
    </Style>

    <!-- Field / section label: sentence case, quiet, never shouty. -->
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextMutedBrush}" />
        <Setter Property="FontFeatures" Value="tnum" />
    </Style>

    <Style Selector="Label">
        <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style Selector="Label.hint">
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextMutedBrush}" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Section title inside settings dialogs. -->
    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
    </Style>

    <!-- ============================== Icons ==================================== -->
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{DynamicResource UiIconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style Selector="TextBlock.icon.accent">
        <Setter Property="Foreground" Value="{DynamicResource UiAccentBrush}" />
    </Style>

    <Style Selector="TextBlock.icon.muted">
        <Setter Property="Foreground" Value="{DynamicResource UiTextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.icon.lg">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ============================== Buttons ================================== -->
    <!-- The Fluent templates are kept; the palette they paint from is overridden
         in Theme.axaml. That keeps focus, hover, pressed and disabled states
         consistent with the rest of the app. -->
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource UiSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderStrongBrush}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceActiveBrush}" />
        <Setter Property="RenderTransform" Value="Scale(0.98)" />
    </Style>

    <Style Selector="Button:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- Primary action: the single accent in the interface. -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource UiAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UiOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    </Style>

    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="{DynamicResource UiAccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentHoverBrush}" />
    </Style>

    <Style Selector="Button.accent:pressed">
        <Setter Property="Background" Value="{DynamicResource UiAccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentPressedBrush}" />
    </Style>

    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    </Style>

    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiAccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentHoverBrush}" />
    </Style>

    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiAccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentPressedBrush}" />
    </Style>

    <!-- Quiet action: no chrome until it is needed. -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Icon-only action (window chrome, response toolbar). -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.icon /template/ TextBlock.icon">
        <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
    </Style>

    <Style Selector="Button.icon:pointerover /template/ TextBlock.icon">
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource UiDangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiDangerBrush}" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ TextBlock.icon">
        <Setter Property="Foreground" Value="{DynamicResource UiDangerBrush}" />
    </Style>

    <!-- ============================ Text inputs ================================ -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource UiSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CaretBrush" Value="{DynamicResource UiAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource UiAccentSoftBrush}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    </Style>

    <Style Selector="TextBox:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Read-only surfaces (clipboard preview, result viewers) read as content,
         not as editable fields. -->
    <Style Selector="TextBox.readonly">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TextBox.readonly:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="TextBox.multiline">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="AcceptsReturn" Value="True" />
    </Style>

    <!-- ============================== ComboBox ================================= -->
    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource UiSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceHoverBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
    </Style>

    <!-- ============================= CheckBox ================================== -->
    <Style Selector="CheckBox">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
    </Style>

    <!-- ============================== ListBox ================================== -->
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceHoverBrush}" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
    </Style>

    <!-- =============================== Tabs ==================================== -->
    <Style Selector="TabControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- A section in a settings dialog: quiet title, hairline, then the fields. -->
    <Style Selector="HeaderedContentControl">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="10" Margin="0,0,0,18">
                    <TextBlock Text="{TemplateBinding Header}" Classes="section-title" />
                    <Border Classes="hairline" />
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource UiTextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource UiSurfaceHoverBrush}" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource UiSurfaceAltBrush}" />
    </Style>

    <!-- ============================== Slider =================================== -->
    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource UiAccentBrush}" />
    </Style>

    <!-- ============================= ToolTip =================================== -->
    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceActiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource UiTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSizeSmall}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- ============================ Containers ================================ -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Border.hairline">
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- Small status pill, e.g. the "your AI companion" tag in the title bar. -->
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{DynamicResource UiSurfaceAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Inline status strip used for connection test results. -->
    <Style Selector="Border.status">
        <Setter Property="Background" Value="{DynamicResource UiAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource UiAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
</Styles>
