<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Version.props" />
  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <CoreCompileDependsOn>PrepareResources;$(CompileDependsOn)</CoreCompileDependsOn>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- <EnableDefaultCompileItems>false</EnableDefaultCompileItems> -->
    <ApplicationIcon>bulb.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishAot>False</PublishAot>
    <PublishTrimmed>False</PublishTrimmed>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <DefineConstants>LINUX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="bulb.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always">
      <LinuxPath>/usr/share/ClippyAI/Assets/bulb.png</LinuxPath>
    </Content>
    <Content Include="clippyai.desktop" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always">
      <LinuxPath>/usr/share/applications/clippyai.desktop</LinuxPath>
    </Content>
  </ItemGroup>
<ItemGroup>
    <Compile Remove="Libs\**" />
    <Compile Remove="Resources\Resources.Designer.cs" />
    <EmbeddedResource Remove="Libs\**" />
    <None Remove="Libs\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Condition="'$(OS)' == 'Windows_NT'" Include="DirectShowLib.Net" Version="3.0.0" />
    <PackageReference Include="Emgu.CV" Version="4.13.0.5924" />
    <PackageReference Condition="'$(OS)' == 'Windows_NT'" Include="Emgu.CV.runtime.mini.windows" Version="4.13.0.5924" />
    <PackageReference Condition="'$(OS)' != 'Windows_NT'" Include="Emgu.CV.runtime.mini.ubuntu-x64" Version="4.12.0.5764" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="LanceDB" Version="2.5.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="ReactiveUI" Version="24.2.0" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
    <PackageReference Include="Tmds.DBus" Version="0.95.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>
  <ItemGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.Wpf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Libs\evdev-sharp\EvDevSharp\EvDevSharp.csproj" />
    <ProjectReference Include="Libs\DesktopNotificationsNet8\DesktopNotifications.Avalonia\DesktopNotifications.Avalonia.csproj" />
    <ProjectReference Include="Libs\DesktopNotificationsNet8\DesktopNotifications.FreeDesktop\DesktopNotifications.FreeDesktop.csproj" />
    <ProjectReference Include="Libs\DesktopNotificationsNet8\DesktopNotifications.Windows\DesktopNotifications.Windows.csproj" />
    <ProjectReference Include="Libs\DesktopNotificationsNet8\DesktopNotifications\DesktopNotifications.csproj" />
  </ItemGroup>
	<ItemGroup>
			<EmbeddedResource Update="Resources\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<PublicClass>true</PublicClass>
			<StronglyTypedFileName>Resources\Resources.Designer.cs</StronglyTypedFileName>
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>ClippyAI.Resources</StronglyTypedNamespace>
			<StronglyTypedClassName>Resources</StronglyTypedClassName>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="powershell -Command &quot;(Get-Content -path $(ProjectDir)\Resources\Resources.Designer.cs) -replace 'internal', 'public' | Set-Content -Path $(ProjectDir)\Resources\Resources.Designer.cs&quot;" Condition="'$(OS)' == 'Windows_NT'" />
    <Exec Command="sed -i 's/internal/public/g' Resources/Resources.Designer.cs" Condition="'$(OS)' == 'Unix'" />
  </Target>
  <Target Name="ClickOnceAvaloniaXaml" AfterTargets="InjectAvaloniaXamlOutput" Condition="'@(AvaloniaResource)@(AvaloniaXaml)' != '' AND $(EnableAvaloniaXamlCompilation) != false">
  <ItemGroup>
    <!-- ClickOnce support -->
    <_DeploymentManifestEntryPoint Remove="@(_DeploymentManifestEntryPoint)" />
    <_DeploymentManifestEntryPoint Include="@(_AvaloniaXamlCompiledAssembly)">
      <TargetPath>$(TargetFileName)</TargetPath>
    </_DeploymentManifestEntryPoint>
  </ItemGroup>
</Target>
  <PropertyGroup>
    <PostInstallScript>chmod 777 /usr/share/ClippyAI
chmod 666 /usr/share/ClippyAI/ClippyAI.dll.config</PostInstallScript>  
  </PropertyGroup>
  <PropertyGroup>
    <Authors>Christoph Döllinger</Authors>
    <PackageProjectUrl>https://github.com/MrDoe/ClippyAI</PackageProjectUrl>
    <PackageDescription>ClippyAI is an AI assistant that captures your clipboard, sends it to a local AI provider and puts the response back into your clipboard.</PackageDescription>
  </PropertyGroup>
  <!-- Dependencies of the generated .deb package (see the CreateDeb target of Packaging.Targets) -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <DebDotNetDependencies Include="dotnet-runtime-10.0" />
    <DebDependency Include="libc6" />
    <DebDependency Include="libgcc1" />
    <DebDependency Include="libgssapi-krb5-2" />
    <DebDependency Include="libstdc++6" />
    <DebDependency Include="zlib1g" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Compile Remove="Services\LinuxHotkeyService.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="Services\WindowsHotkeyService.cs" />
  </ItemGroup>
  <!--
    A portable publish (no RuntimeIdentifier) copies the native assets of every
    runtime identifier a package ships. That put 37 RID folders (~686 MB) into
    the publish output and the .deb. Keep only the native libraries that can be
    loaded on the target OS:
      Linux:   linux-x64 (SkiaSharp, HarfBuzz, SQLitePCLRaw) and ubuntu-x64
               (Emgu.CV's libcvextern.so).
      Windows: win-x64 (SkiaSharp, HarfBuzz, ANGLE, Emgu) and win.
    Managed runtime assets (runtimes/*/lib) are left untouched: they are small
    and provide fallbacks the host may need.
  -->
  <Target Name="FilterNativeAssetsForPackage"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(RuntimeIdentifier)' == ''">
    <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/'))
          and ($([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').Contains('/native/'))
            or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').Contains('/nativeassets/')))
          and !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/linux-x64/native/'))
          and !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/ubuntu-x64/native/'))" />
    </ItemGroup>
    <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/'))
          and ($([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').Contains('/native/'))
            or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').Contains('/nativeassets/')))
          and !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/win-x64/native/'))
          and !$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/win/native/'))" />
    </ItemGroup>
  </Target>
</Project>
