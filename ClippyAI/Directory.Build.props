<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Provides the CreateDeb/CreateRpm/CreateTarball targets.
      Pinned to an exact version: the floating "0.1.226-*" range only ever
      resolves to the 0.1.226 patch line, so it never picked up 0.1.232.
    -->
    <PackageReference Include="Packaging.Targets">
      <Version>0.1.232</Version>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>