<Application xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ClippyAI.Views"
    xmlns:local="using:ClippyAI"
    xmlns:converters="using:ClippyAI.Converters"
    Name="ClippyAI"
    x:Class="ClippyAI.App"
    x:DataType="vm:ApplicationViewModel"
    RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <converters:InvariantNumberConverter x:Key="InvariantNumber" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ClippyAI/Styles/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Component styles, kept out of the app shell. -->
        <StyleInclude Source="avares://ClippyAI/Styles/Controls.axaml" />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="320" />
            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
        </Style>
    </Application.Styles>
</Application>
