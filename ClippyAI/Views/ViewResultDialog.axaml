<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ClippyAI.Views.ViewResultDialog"
    x:DataType="vm:ViewResultDialogViewModel"
    xmlns:vm="clr-namespace:ClippyAI.Views"
    xmlns:resources="clr-namespace:ClippyAI.Resources"
    Width="900"
    Height="600"
    MinWidth="480" MinHeight="320"
    Background="Transparent"
    CanResize="True"
    Topmost="True"
    TransparencyLevelHint="AcrylicBlur"
    ExtendClientAreaToDecorationsHint="True"
    WindowStartupLocation="CenterScreen"
    Title="{x:Static resources:Resources.ClippyAIResult}">
    <Border CornerRadius="12"
            BorderBrush="{DynamicResource UiBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource UiWindowBgTranslucentBrush}">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top"
                    Padding="24,20,24,14"
                    Background="Transparent"
                    WindowDecorationProperties.ElementRole="TitleBar">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="icon lg" Text="&#xf15c;"
                               Foreground="{DynamicResource UiAccentBrush}" />
                    <TextBlock Text="{x:Static resources:Resources.ClippyAIResult}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="24,12,24,18">
                <Button Content="{x:Static resources:Resources.OK}"
                        Classes="accent"
                        HorizontalAlignment="Right"
                        Width="110"
                        Command="{Binding CloseCommand}" />
            </Border>

            <Border Margin="24,4,24,0">
                <TextBox Text="{Binding ResultText}"
                         Classes="multiline"
                         TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </Border>
        </DockPanel>
    </Border>
</Window>
