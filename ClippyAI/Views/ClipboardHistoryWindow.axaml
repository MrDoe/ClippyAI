<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ClippyAI.Views"
    xmlns:models="clr-namespace:ClippyAI.Models"
    xmlns:resources="clr-namespace:ClippyAI.Resources"
    x:Class="ClippyAI.Views.ClipboardHistoryWindow"
    x:DataType="vm:MainViewModel"
    Title="{x:Static resources:Resources.ClipboardHistory}"
    Width="720" Height="700"
    MinWidth="560" MinHeight="420"
    WindowStartupLocation="CenterOwner"
    TransparencyLevelHint="AcrylicBlur"
    Background="Transparent"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    Topmost="True"
    CanResize="True"
    ShowInTaskbar="False">

    <Border CornerRadius="14"
            BorderBrush="{DynamicResource UiBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource UiWindowBgTranslucentBrush}"
            ClipToBounds="True">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Padding="24,18,24,10" Background="Transparent"
                    WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Classes="icon" Text="&#xf1da;" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static resources:Resources.ClipboardHistory}"
                                   FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static resources:Resources.ClipboardHistorySubtitle}"
                                   Classes="hint" />
                    </StackPanel>
                    <TextBox Grid.Column="2" Width="220" VerticalAlignment="Center"
                             Text="{Binding HistoryFilter}"
                             PlaceholderText="{x:Static resources:Resources.HistoryFilterPlaceholder}" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="24,12,24,16"
                    Background="{DynamicResource UiSurfaceBrush}"
                    BorderBrush="{DynamicResource UiBorderBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Name="RestoreButton" Content="{x:Static resources:Resources.HistoryRestore}"
                                ToolTip.Tip="{x:Static resources:Resources.HistoryRestoreDescription}" />
                        <Button Name="ExecuteButton" Content="{x:Static resources:Resources.TaskStart}"
                                ToolTip.Tip="{x:Static resources:Resources.HistoryExecuteDescription}" />
                        <Button Name="DeleteButton" Classes="danger" Content="{x:Static resources:Resources.Delete}" />
                        <Button Name="ClearButton" Content="{x:Static resources:Resources.HistoryClear}"
                                ToolTip.Tip="{x:Static resources:Resources.HistoryClearDescription}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Name="ManualButton" Classes="accent"
                                Content="{x:Static resources:Resources.GenerateManual}"
                                ToolTip.Tip="{x:Static resources:Resources.GenerateManualDescription}" />
                        <Button Name="CloseButton" Width="112" IsCancel="True"
                                Content="{x:Static resources:Resources.Close}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="24,8,24,8">
                <ListBox Name="HistoryList"
                         ItemsSource="{Binding HistoryItems}"
                         SelectedItem="{Binding SelectedHistoryItem}"
                         SelectionMode="Multiple"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ClipboardHistoryItem">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="mono" FontSize="11"
                                               Foreground="{DynamicResource UiTextSecondaryBrush}"
                                               Text="{Binding CreatedAtDisplay}" />
                                    <Border Background="{DynamicResource UiAccentSoftBrush}"
                                            CornerRadius="999" Padding="8,1" IsVisible="{Binding IsImage}">
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource UiAccentBrush}"
                                                   Text="IMAGE" />
                                    </Border>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource UiTextSecondaryBrush}"
                                               Text="{Binding SourceContext}" />
                                </StackPanel>

                                <Image Source="{Binding Thumbnail}"
                                       MaxHeight="120" Stretch="Uniform"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding IsImage}" />

                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap"
                                           IsVisible="{Binding !IsImage}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Name="EmptyStatePanel" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Classes="icon lg" Text="&#xf1da;"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource UiTextMutedBrush}" />
                    <TextBlock Text="{x:Static resources:Resources.HistoryEmpty}"
                               Classes="hint" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
