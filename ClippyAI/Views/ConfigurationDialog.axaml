<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:ClippyAI.ViewModels"
    xmlns:models="clr-namespace:ClippyAI.Models"
    x:Class="ClippyAI.Views.ConfigurationDialog"
    x:DataType="vm:ConfigurationDialogViewModel"
    x:Name="ConfigurationWindow"
    xmlns:resources="clr-namespace:ClippyAI.Resources"
    Title="{x:Static resources:Resources.Configuration}"
    Width="860" Height="840"
    MinWidth="700" MinHeight="520"
    WindowStartupLocation="CenterScreen"
    TransparencyLevelHint="AcrylicBlur"
    Background="Transparent"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    Topmost="True"
    CanResize="True"
    ShowInTaskbar="False">

    <Window.Styles>
        <!-- Dialog-wide field rhythm: label, control, breathing room. -->
        <Style Selector="Label">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Styles>

    <Border CornerRadius="14"
            BorderBrush="{DynamicResource UiBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource UiWindowBgTranslucentBrush}"
            ClipToBounds="True">
        <DockPanel LastChildFill="True">

            <!-- ============================ Header ============================== -->
            <Border DockPanel.Dock="Top"
                    Padding="24,20,24,14"
                    Background="Transparent"
                    WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static resources:Resources.Configuration}"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{x:Static resources:Resources.ConfigurationSubtitle}"
                                   Classes="hint" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Footer ============================== -->
            <Border DockPanel.Dock="Bottom"
                    Padding="24,14,24,18"
                    Background="{DynamicResource UiSurfaceBrush}"
                    BorderBrush="{DynamicResource UiBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel x:Name="SaveStatusPanel"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                IsVisible="False">
                        <TextBlock Classes="icon" Text="&#xf058;"
                                   Foreground="{DynamicResource UiSuccessBrush}" />
                        <TextBlock Text="{x:Static resources:Resources.Saved}"
                                   Foreground="{DynamicResource UiTextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Name="CloseButton" Width="112" IsCancel="True"
                                Content="{x:Static resources:Resources.Close}" />
                        <Button Name="SaveButton" Classes="accent" Width="112" IsDefault="True">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon" Text="&#xf00c;"
                                           Foreground="{DynamicResource UiOnAccentBrush}" />
                                <TextBlock Text="{x:Static resources:Resources.Save}"
                                           Foreground="{DynamicResource UiOnAccentBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================ Content ============================= -->
            <TabControl Margin="24,8,24,0">

                <!-- General -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xf013;" />
                            <TextBlock Text="{x:Static resources:Resources.General}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,18,0,24" MaxWidth="760" HorizontalAlignment="Left">
                            <HeaderedContentControl Header="{x:Static resources:Resources.AIProviderSettings}">
                                <StackPanel>
                                    <Label Content="{x:Static resources:Resources.AIProvider}" />
                                    <ComboBox ItemsSource="{Binding AiProviderItems}"
                                              SelectedItem="{Binding AiProvider}"
                                              ToolTip.Tip="{x:Static resources:Resources.AIProviderDescription}" />

                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                        <Button Command="{Binding TestConnectionCommand}"
                                                IsEnabled="{Binding !GeneralTestInProgress}"
                                                ToolTip.Tip="{x:Static resources:Resources.TestConnectionDescription}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="icon" Text="&#xf1e6;" />
                                                <TextBlock Text="{x:Static resources:Resources.TestConnection}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{x:Static resources:Resources.Testing}"
                                                   IsVisible="{Binding GeneralTestInProgress}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource UiAccentBrush}" />
                                    </StackPanel>

                                    <Border Classes="status"
                                            Margin="0,12,0,0"
                                            IsVisible="{Binding GeneralTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding GeneralTestResult}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource UiTextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="{x:Static resources:Resources.OllamaSettings}">
                                <StackPanel>
                                    <Label Content="{x:Static resources:Resources.OllamaUrl}" />
                                    <TextBox Text="{Binding OllamaUrl}"
                                             ToolTip.Tip="{x:Static resources:Resources.OllamaUrlDescription}" />
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="{x:Static resources:Resources.OpenAISettings}">
                                <StackPanel>
                                    <Label Content="{x:Static resources:Resources.OpenAIApiKey}" />
                                    <TextBox Text="{Binding OpenAIApiKey}" PasswordChar="*"
                                             ToolTip.Tip="{x:Static resources:Resources.OpenAIApiKeyDescription}" />

                                    <Label Content="{x:Static resources:Resources.OpenAIBaseUrl}" />
                                    <TextBox Text="{Binding OpenAIBaseUrl}"
                                             ToolTip.Tip="{x:Static resources:Resources.OpenAIBaseUrlDescription}" />
                                </StackPanel>
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="{x:Static resources:Resources.DefaultModel}">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <ComboBox ItemsSource="{Binding ModelItems}"
                                              SelectedItem="{Binding OllamaModel}"
                                              ToolTip.Tip="{x:Static resources:Resources.SelectModelDescription}" />
                                    <Button Grid.Column="1" Classes="icon" Command="{Binding AddModelCommand}"
                                            ToolTip.Tip="{x:Static resources:Resources.PullModelDescription}">
                                        <TextBlock Classes="icon" Text="&#xf019;" />
                                    </Button>
                                    <Button Grid.Column="2" Classes="icon danger" Command="{Binding DeleteModelCommand}"
                                            ToolTip.Tip="{x:Static resources:Resources.DeleteModelDescription}">
                                        <TextBlock Classes="icon" Text="&#xf2ed;" />
                                    </Button>
                                    <Button Grid.Column="3" Classes="icon" Command="{Binding RefreshModelsCommand}"
                                            ToolTip.Tip="{x:Static resources:Resources.RefreshModelListDescription}">
                                        <TextBlock Classes="icon" Text="&#xf2f1;" />
                                    </Button>
                                </Grid>
                            </HeaderedContentControl>

                            <HeaderedContentControl Header="{x:Static resources:Resources.General}">
                                <StackPanel>
                                    <Label Content="{x:Static resources:Resources.Language}" />
                                    <ComboBox ItemsSource="{Binding LanguageItems}"
                                              SelectedItem="{Binding DefaultLanguage}"
                                              ToolTip.Tip="{x:Static resources:Resources.DefaultLanguageDescription}" />

                                    <CheckBox IsChecked="{Binding AutoMode}"
                                              Content="{x:Static resources:Resources.AutoMode}"
                                              ToolTip.Tip="{x:Static resources:Resources.AutoModeDescription}" />

                                    <Label Content="{x:Static resources:Resources.DefaultTask}" />
                                    <ComboBox ItemsSource="{Binding AvailableTasks}"
                                              SelectedItem="{Binding DefaultTask}"
                                              ToolTip.Tip="{x:Static resources:Resources.DefaultTaskDescription}" />

                                    <Label Content="{x:Static resources:Resources.SystemPrompt}" />
                                    <TextBox Text="{Binding SystemPrompt}" Height="150" TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             ToolTip.Tip="{x:Static resources:Resources.SystemPromptDescription}" />
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Embeddings -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xf1c0;" />
                            <TextBlock Text="{x:Static resources:Resources.Embeddings}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,18,0,24" MaxWidth="760" HorizontalAlignment="Left">
                            <HeaderedContentControl Header="{x:Static resources:Resources.VectorDatabaseSettings}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding UseEmbeddings}"
                                              Content="{x:Static resources:Resources.UseEmbeddings}"
                                              ToolTip.Tip="{x:Static resources:Resources.UseEmbeddingsDescription}" />

                                    <CheckBox IsChecked="{Binding StoreAllResponses}"
                                              Content="{x:Static resources:Resources.StoreAllResponses}"
                                              ToolTip.Tip="{x:Static resources:Resources.StoreAllResponsesDescription}" />

                                    <TextBlock Text="{x:Static resources:Resources.EmbeddingsProviderHint}"
                                               Classes="hint" Margin="0,0,0,14" />

                                    <Label Content="{x:Static resources:Resources.VectorDbPath}" />
                                    <TextBox Text="{Binding VectorDbPath}"
                                             PlaceholderText="{x:Static resources:Resources.VectorDbPathDescription}"
                                             ToolTip.Tip="{x:Static resources:Resources.VectorDbPathDescription}"
                                             IsEnabled="{Binding UseEmbeddings}" />

                                    <Label Content="{x:Static resources:Resources.OllamaEmbeddingModel}" />
                                    <TextBox Text="{Binding OllamaEmbeddingModel}"
                                             ToolTip.Tip="{x:Static resources:Resources.OllamaEmbeddingModelDescription}"
                                             IsEnabled="{Binding UseEmbeddings}" />

                                    <Label Content="{x:Static resources:Resources.OpenAIEmbeddingModel}" />
                                    <TextBox Text="{Binding OpenAIEmbeddingModel}"
                                             ToolTip.Tip="{x:Static resources:Resources.OpenAIEmbeddingModelDescription}"
                                             IsEnabled="{Binding UseEmbeddings}" />

                                    <Label Content="{x:Static resources:Resources.Threshold}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Slider Value="{Binding Threshold}" Minimum="-1" Maximum="1"
                                                TickFrequency="0.1"
                                                ToolTip.Tip="{x:Static resources:Resources.ThresholdDescription}" />
                                        <TextBox Grid.Column="1" Text="{Binding Threshold}" Width="72" />
                                    </Grid>

                                    <Button Content="{x:Static resources:Resources.ClearDatabase}"
                                            Command="{Binding ClearEmbeddingsCommand}"
                                            HorizontalAlignment="Left" Margin="0,0,0,16"
                                            ToolTip.Tip="{x:Static resources:Resources.ClearDatabaseDescription}" />

                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static resources:Resources.EmbeddingsCount}"
                                                   Foreground="{DynamicResource UiTextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Border Background="{DynamicResource UiAccentSoftBrush}"
                                                CornerRadius="999" Padding="10,3">
                                            <TextBlock Text="{Binding EmbeddingsCount}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource UiAccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Vision -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xf03d;" />
                            <TextBlock Text="{x:Static resources:Resources.VisionTab}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,18,0,24" MaxWidth="760" HorizontalAlignment="Left">
                            <HeaderedContentControl Header="{x:Static resources:Resources.VisionSettings}">
                                <StackPanel>
                                    <Label Content="{x:Static resources:Resources.VideoDevice}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <ComboBox ItemsSource="{Binding VideoDevices}"
                                                  SelectedItem="{Binding VideoDevice}"
                                                  PlaceholderText="{x:Static resources:Resources.VideoDeviceDescription}"
                                                  ToolTip.Tip="{x:Static resources:Resources.VideoDeviceDescription}" />
                                        <Button Grid.Column="1" Content="{x:Static resources:Resources.Refresh}"
                                                Command="{Binding RefreshVideoDevicesCommand}"
                                                ToolTip.Tip="{x:Static resources:Resources.RefreshVideoDevicesDescription}" />
                                        <Button Grid.Column="2" Content="{x:Static resources:Resources.ViewCamera}"
                                                Command="{Binding ShowCamera}"
                                                ToolTip.Tip="{x:Static resources:Resources.ViewCameraDescription}" />
                                    </Grid>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- System -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xf233;" />
                            <TextBlock Text="{x:Static resources:Resources.SystemTab}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,18,0,24" MaxWidth="760" HorizontalAlignment="Left">
                            <HeaderedContentControl Header="{x:Static resources:Resources.SystemSettings}">
                                <StackPanel>
                                    <Label Content="{x:Static resources:Resources.LinuxKeyboardDevice}" />
                                    <TextBox Text="{Binding LinuxKeyboardDevice}"
                                             PlaceholderText="{x:Static resources:Resources.LinuxKeyboardDeviceDescription}"
                                             ToolTip.Tip="{x:Static resources:Resources.LinuxKeyboardDeviceDescription}" />

                                    <Button Content="{x:Static resources:Resources.ConfigureHotkeyDevice}"
                                            Command="{Binding ConfigureHotkeyDeviceCommand}"
                                            HorizontalAlignment="Left" Margin="0,0,0,8"
                                            ToolTip.Tip="{x:Static resources:Resources.ConfigureHotkeyDeviceDescription}" />
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- SSH -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xf023;" />
                            <TextBlock Text="{x:Static resources:Resources.SSH}" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,18,0,24" MaxWidth="760" HorizontalAlignment="Left">
                            <HeaderedContentControl Header="{x:Static resources:Resources.SSHTunnelSettings}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding UseSSH}"
                                              Content="{x:Static resources:Resources.EnableSSHTunneling}"
                                              ToolTip.Tip="{x:Static resources:Resources.EnableSSHTunnelingDescription}" />

                                    <Label Content="{x:Static resources:Resources.SSHUsername}" />
                                    <TextBox Text="{Binding SshUsername}"
                                             ToolTip.Tip="{x:Static resources:Resources.SSHUsernameDescription}" />

                                    <Label Content="{x:Static resources:Resources.SSHServer}" />
                                    <TextBox Text="{Binding SshServerUrl}"
                                             ToolTip.Tip="{x:Static resources:Resources.SSHServerDescription}" />

                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <Label Content="{x:Static resources:Resources.SSHPort}" />
                                            <TextBox Text="{Binding SshPort}"
                                                     ToolTip.Tip="{x:Static resources:Resources.SSHPortDescription}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Label Content="{x:Static resources:Resources.LocalTunnel}" />
                                            <TextBox Text="{Binding SshLocalTunnel}"
                                                     ToolTip.Tip="{x:Static resources:Resources.LocalTunnelDescription}" />
                                        </StackPanel>
                                    </Grid>

                                    <Label Content="{x:Static resources:Resources.RemoteTunnel}" />
                                    <TextBox Text="{Binding SshRemoteTunnel}"
                                             ToolTip.Tip="{x:Static resources:Resources.RemoteTunnelDescription}" />

                                    <Label Content="{x:Static resources:Resources.PrivateKeyFile}" />
                                    <TextBox Text="{Binding SshPrivateKeyFile}"
                                             ToolTip.Tip="{x:Static resources:Resources.PrivateKeyFileDescription}" />

                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                        <Button Command="{Binding TestSSHConnectionCommand}"
                                                IsEnabled="{Binding !SshTestInProgress}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="icon" Text="&#xf1e6;" />
                                                <TextBlock Text="{x:Static resources:Resources.TestSSHConnection}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{x:Static resources:Resources.Testing}"
                                                   IsVisible="{Binding SshTestInProgress}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource UiAccentBrush}" />
                                    </StackPanel>

                                    <Border Classes="status"
                                            Margin="0,12,0,0"
                                            IsVisible="{Binding SshTestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding SshTestResult}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource UiTextPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Tasks -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="icon" Text="&#xf0ca;" />
                            <TextBlock Text="{x:Static resources:Resources.TasksTab}" />
                        </StackPanel>
                    </TabItem.Header>

                    <Grid Margin="0,18,0,24" ColumnDefinitions="300,*">
                        <!-- Task list -->
                        <Border Grid.Column="0" Classes="panel" Padding="14" Margin="0,0,14,0">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="{x:Static resources:Resources.Tasks}"
                                           Classes="section-title" Margin="0,0,0,10" />

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding TaskConfigurations}"
                                         SelectedItem="{Binding SelectedTaskConfiguration}"
                                         Margin="0,0,0,14">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TaskConfiguration">
                                            <TextBlock Text="{Binding TaskName}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="2">
                                    <Label Content="{x:Static resources:Resources.NewTaskName}" />
                                    <TextBox Text="{Binding NewTaskName}" Margin="0,0,0,10" />

                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <Button Content="{x:Static resources:Resources.Add}"
                                                Command="{Binding AddNewTaskCommand}"
                                                HorizontalAlignment="Stretch" Margin="0,0,4,0" />
                                        <Button Content="{x:Static resources:Resources.Delete}"
                                                Command="{Binding DeleteTaskCommand}"
                                                HorizontalAlignment="Stretch" Margin="4,0,0,0" />
                                    </UniformGrid>

                                    <Button Content="{x:Static resources:Resources.RestoreDefault}"
                                            Command="{Binding RestoreDefaultTasksCommand}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="{x:Static resources:Resources.RestoreDefaultTasksDescription}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Task details -->
                        <Border Grid.Column="1" Classes="panel" Padding="18">
                            <Grid>
                                <ContentControl Content="{Binding SelectedTaskConfiguration}">
                                    <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="models:TaskConfiguration">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <HeaderedContentControl Header="{x:Static resources:Resources.TaskConfiguration}">
                                                    <StackPanel>
                                                        <Label Content="{x:Static resources:Resources.TaskName}" />
                                                        <TextBox Text="{Binding TaskName}" IsReadOnly="True"
                                                                 Classes="readonly" />

                                                        <Label Content="{x:Static resources:Resources.Prompt}" />
                                                        <TextBox Text="{Binding SystemPrompt}" Height="120"
                                                                 TextWrapping="Wrap" AcceptsReturn="True" />

                                                        <Label Content="{x:Static resources:Resources.Model}" />
                                                        <ComboBox ItemsSource="{x:Static vm:ConfigurationDialogViewModel.AvailableModels}"
                                                                  SelectedItem="{Binding Model}"
                                                                  ToolTip.Tip="{x:Static resources:Resources.ModelDescription}" />

                                                        <CheckBox IsChecked="{Binding IsImageTask}"
                                                                  Content="{x:Static resources:Resources.IsImageTask}"
                                                                  ToolTip.Tip="{x:Static resources:Resources.IsImageTaskDescription}" />

                                                        <StackPanel IsVisible="{Binding IsImageTask}">
                                                            <Label Content="{x:Static resources:Resources.ImageSource}" />
                                                            <ComboBox ItemsSource="{x:Static vm:ConfigurationDialogViewModel.ImageSources}"
                                                                      SelectedItem="{Binding ImageSource}"
                                                                      ToolTip.Tip="{x:Static resources:Resources.ImageSourceDescription}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </HeaderedContentControl>

                                                <Border Classes="panel" Padding="14" Background="{DynamicResource UiSurfaceAltBrush}">
                                                    <Grid ColumnDefinitions="*,1.5*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                                        <Label Grid.Row="0" Grid.Column="0" Content="{x:Static resources:Resources.Temperature}" VerticalAlignment="Center" />
                                                        <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,70" ColumnSpacing="12" Margin="0,0,0,10">
                                                            <Slider Value="{Binding Temperature}" Minimum="0" Maximum="2" />
                                                            <TextBox Grid.Column="1" Text="{Binding Temperature}" />
                                                        </Grid>

                                                        <Label Grid.Row="1" Grid.Column="0" Content="{x:Static resources:Resources.MaxLength}" VerticalAlignment="Center" />
                                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxLength}" Width="100" HorizontalAlignment="Left" />

                                                        <Label Grid.Row="2" Grid.Column="0" Content="{x:Static resources:Resources.TopP}" VerticalAlignment="Center" />
                                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,70" ColumnSpacing="12" Margin="0,0,0,10">
                                                            <Slider Value="{Binding TopP}" Minimum="0" Maximum="1" />
                                                            <TextBox Grid.Column="1" Text="{Binding TopP}" />
                                                        </Grid>

                                                        <Label Grid.Row="3" Grid.Column="0" Content="{x:Static resources:Resources.TopK}" VerticalAlignment="Center" />
                                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TopK}" Width="100" HorizontalAlignment="Left" />

                                                        <Label Grid.Row="4" Grid.Column="0" Content="{x:Static resources:Resources.RepeatPenalty}" VerticalAlignment="Center" />
                                                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,70" ColumnSpacing="12" Margin="0,0,0,10">
                                                            <Slider Value="{Binding RepeatPenalty}" Minimum="0.5" Maximum="2" />
                                                            <TextBox Grid.Column="1" Text="{Binding RepeatPenalty}" />
                                                        </Grid>

                                                        <Label Grid.Row="5" Grid.Column="0" Content="{x:Static resources:Resources.ContextLength}" VerticalAlignment="Center" />
                                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding NumCtx}" Width="100" HorizontalAlignment="Left" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <!-- Empty state: no task selected yet. -->
                            <StackPanel Spacing="10"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding SelectedTaskConfiguration, Converter={x:Static ObjectConverters.IsNull}}">
                                <TextBlock Classes="icon lg"
                                           Text="&#xf0ca;"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource UiTextMutedBrush}" />
                                <TextBlock Text="{x:Static resources:Resources.SelectTask}"
                                           Classes="hint"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
