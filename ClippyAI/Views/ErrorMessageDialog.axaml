<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ClippyAI.Views.ErrorMessageDialog"
    x:DataType="vm:ErrorMessageDialogViewModel"
    xmlns:vm="clr-namespace:ClippyAI.Views"
    xmlns:resources="clr-namespace:ClippyAI.Resources"
    Width="460"
    Height="200"
    TransparencyLevelHint="AcrylicBlur"
    Background="Transparent"
    ExtendClientAreaToDecorationsHint="True"
    WindowStartupLocation="CenterScreen"
    CanResize="false"
    Topmost="True">
    <Border CornerRadius="12"
            BorderBrush="{DynamicResource UiBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource UiWindowBgTranslucentBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto" Margin="22,20,22,18">
            <Border Grid.Row="0" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="icon lg" Text="&#xf071;"
                               Foreground="{DynamicResource UiDangerBrush}" />
                    <TextBlock Text="{x:Static resources:Resources.ClippyAIError}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource UiTextSecondaryBrush}"
                       Margin="0,14,0,0" />

            <Button Grid.Row="2"
                    Content="{x:Static resources:Resources.OK}"
                    Classes="accent"
                    HorizontalAlignment="Right"
                    Width="110"
                    Margin="0,20,0,0"
                    Command="{Binding CloseCommand}" />
        </Grid>
    </Border>
</Window>
