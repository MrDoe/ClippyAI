<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ClippyAI.Views"
    xmlns:resources="clr-namespace:ClippyAI.Resources"
    mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="780"
    Padding="0"
    x:Class="ClippyAI.Views.MainView"
    x:DataType="vm:MainViewModel"
    Loaded="MainView_Loaded">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,4,16,16" RowDefinitions="Auto,Auto,*">

            <!-- ============================ Clipboard =========================== -->
            <Border Grid.Row="0" Classes="card">
                <StackPanel Spacing="10">

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="icon" Text="&#xf328;" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Classes="label"
                                   Text="{x:Static resources:Resources.ClipboardContent}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button Classes="icon"
                                    Command="{Binding ShowCameraCommand}"
                                    ToolTip.Tip="{x:Static resources:Resources.ViewCameraDescription}">
                                <TextBlock Classes="icon" Text="&#xf030;" />
                            </Button>
                            <Button Classes="icon"
                                    Command="{Binding CaptureScreenshotCommand}"
                                    ToolTip.Tip="{x:Static resources:Resources.CaptureScreenshotDescription}">
                                <TextBlock Classes="icon" Text="&#xf03e;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="txtInput"
                             Classes="readonly"
                             Text="{Binding Input}"
                             IsReadOnly="True"
                             Height="132"
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ToolTip.Tip="{x:Static resources:Resources.ClipboardContentDescription}"
                             IsVisible="{Binding IsTextInputVisible}" />

                    <Image x:Name="imgClipboard"
                           Source="{Binding ClipboardImage}"
                           Height="180"
                           Stretch="Uniform"
                           ToolTip.Tip="{x:Static resources:Resources.ClipboardImageDescription}"
                           IsVisible="{Binding IsImageInputVisible}" />
                </StackPanel>
            </Border>

            <!-- ============================== Task ============================== -->
            <Border Grid.Row="1" Classes="card" Margin="0,14,0,0">
                <StackPanel Spacing="10">

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Classes="icon" Text="&#xf0eb;" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Classes="label"
                                   Text="{x:Static resources:Resources.Task}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ComboBox x:Name="cboTaskConfig"
                              SelectedItem="{Binding SelectedTaskConfiguration}"
                              ItemsSource="{Binding TaskConfigurations}"
                              HorizontalAlignment="Stretch"
                              ToolTip.Tip="{x:Static resources:Resources.SelectTaskDescription}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TaskName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Classes="accent"
                                Command="{Binding AskClippyCommand}"
                                Height="38"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="{x:Static resources:Resources.TaskStartDescription}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="icon"
                                           Text="&#xf04b;"
                                           Foreground="{DynamicResource UiOnAccentBrush}" />
                                <TextBlock Text="{x:Static resources:Resources.TaskStart}"
                                           Foreground="{DynamicResource UiOnAccentBrush}" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Classes="icon"
                                Command="{Binding StopClippyTaskCommand}"
                                ToolTip.Tip="{x:Static resources:Resources.TaskStopDescription}">
                            <TextBlock Classes="icon" Text="&#xf04d;" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================ Response ============================ -->
            <Border Grid.Row="2" Classes="card" Margin="0,14,0,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="icon" Text="&#xf15c;" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Classes="label"
                                   Text="{x:Static resources:Resources.Output}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="mono"
                                       Text="{Binding ResponseCounter}"
                                       ToolTip.Tip="{x:Static resources:Resources.ResponseCounterDescription}" />
                            <TextBlock Classes="mono"
                                       Text="{Binding ResponseDistance}"
                                       ToolTip.Tip="{x:Static resources:Resources.ResponseDistanceDescription}" />
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="txtOutput"
                             Grid.Row="1"
                             Text="{Binding Output}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             MinHeight="200"
                             Margin="0,10,0,10"
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ToolTip.Tip="{x:Static resources:Resources.OutputDescription}" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                        <Button Classes="icon"
                                Command="{Binding GetNextResponseCommand}"
                                ToolTip.Tip="{x:Static resources:Resources.GetNextResponseDescription}">
                            <TextBlock Classes="icon" Text="&#xf101;" />
                        </Button>
                        <Button Classes="icon"
                                Command="{Binding ThumbUpCommand}"
                                ToolTip.Tip="{x:Static resources:Resources.ThumbUpDescription}">
                            <TextBlock Classes="icon" Text="&#xf164;" />
                        </Button>
                        <Button Classes="icon"
                                Command="{Binding ThumbDownCommand}"
                                ToolTip.Tip="{x:Static resources:Resources.ThumbDownDescription}">
                            <TextBlock Classes="icon" Text="&#xf165;" />
                        </Button>
                        <Button Classes="icon"
                                Command="{Binding RegenerateCommand}"
                                ToolTip.Tip="{x:Static resources:Resources.RegenerateDescription}">
                            <TextBlock Classes="icon" Text="&#xf2f1;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
