<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ClippyAI.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:ClippyAI.Views"
    xmlns:resources="clr-namespace:ClippyAI.Resources"
    mc:Ignorable="d"
    Width="520"
    Height="780"
    MinWidth="420"
    MinHeight="520"
    x:Class="ClippyAI.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    Icon="avares://ClippyAI/Assets/bulb.png"
    Title="ClippyAI"
    TransparencyLevelHint="AcrylicBlur"
    Background="Transparent"
    Loaded="MainWindow_Loaded"
    CanResize="True"
    Topmost="True"
    ShowInTaskbar="False"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    WindowDecorations="BorderOnly">

    <!-- Floating panel: a single calm surface with a hairline edge. -->
    <Border Name="border"
            CornerRadius="14"
            BorderBrush="{DynamicResource UiBorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource UiWindowBgTranslucentBrush}"
            ClipToBounds="True">

        <DockPanel LastChildFill="True">

            <!-- Title bar. Tagged as TitleBar so the window stays draggable. -->
            <Border DockPanel.Dock="Top"
                    Padding="16,14,10,12"
                    Background="Transparent"
                    WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <Border Grid.Column="0"
                            Width="30" Height="30"
                            CornerRadius="8"
                            Background="{DynamicResource UiSurfaceAltBrush}"
                            ClipToBounds="True">
                        <Image Source="/Assets/bulb_high_128.png" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="ClippyAI" Classes="title" VerticalAlignment="Center" />
                        <Border Classes="pill" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource UiAccentBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static resources:Resources.AICompanion}"
                                           FontSize="{DynamicResource UiFontSizeMicro}"
                                           Foreground="{DynamicResource UiTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button Classes="icon"
                                Command="{Binding OpenConfigurationCommand}"
                                ToolTip.Tip="{x:Static resources:Resources.ConfigurationDescription}">
                            <TextBlock Classes="icon" Text="&#xf013;" />
                        </Button>
                        <Button Classes="icon"
                                Click="MinimizeButton_Click"
                                ToolTip.Tip="{x:Static resources:Resources.Minimize}">
                            <TextBlock Classes="icon" Text="&#xf068;" />
                        </Button>
                        <Button Classes="icon danger"
                                Click="CloseButton_Click"
                                ToolTip.Tip="{x:Static resources:Resources.CloseApplication}">
                            <TextBlock Classes="icon" Text="&#xf00d;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <views:MainView />
        </DockPanel>
    </Border>
</Window>
