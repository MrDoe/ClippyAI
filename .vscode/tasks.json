{
    // Tasks for building, packaging and running ClippyAI.
    //
    // The Linux packaging tasks (publish-linux-deb/rpm/tar) rely on the
    // Packaging.Targets NuGet package. Its .deb writer compresses the payload
    // with liblzma's multithreaded encoder, which fails intermittently on
    // Linux with "Specified preset is not supported" (MSB4018). Forcing a
    // single processor makes the package use liblzma's single threaded
    // encoder, which is stable. Hence DOTNET_PROCESSOR_COUNT=1 below.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "msbuild",
            "command": "dotnet",
            "type": "process",
            "args": [
                "msbuild",
                "${workspaceFolder}/ClippyAI.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/ClippyAI.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-debug",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/ClippyAI.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign",
                "/p:Configuration=Debug"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-release",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/ClippyAI.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign",
                "/p:Configuration=Release"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-windows",
            "dependsOn": ["build-release"],
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/ClippyAI/ClippyAI.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign",
                "/p:Configuration=Release",
                "/p:TargetFramework=net10.0-windows10.0.17763.0"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-windows-msi",
            "command": "powershell",
            "type": "process",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}/scripts/publish-windows-msi-release.ps1' --check-only; if ($LASTEXITCODE -ne 0) { dotnet build '${workspaceFolder}/Installer/ClippyAI.Installer.wixproj' /property:GenerateFullPaths=true /consoleloggerparameters:NoSummary;ForceNoAlign /p:Configuration=Release }"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-windows-msi-release",
            "dependsOn": ["publish-windows-msi"],
            "dependsOrder": "sequence",
            "command": "powershell",
            "type": "process",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/publish-windows-msi-release.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "publish-linux-deb",
            "dependsOn": ["build-release"],
            "command": "dotnet",
            "type": "process",
            "args": [
                "msbuild",
                "${workspaceFolder}/ClippyAI/ClippyAI.csproj",
                "/t:CreateDeb",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign",
                "/p:Configuration=Release"
            ],
            "options": {
                // The packaging tasks receive the publish folder as a relative
                // path, so they have to run in the project directory.
                "cwd": "${workspaceFolder}/ClippyAI",
                "env": {
                    "DOTNET_PROCESSOR_COUNT": "1"
                }
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-linux-rpm",
            "dependsOn": ["build-release"],
            "command": "dotnet",
            "type": "process",
            "args": [
                "msbuild",
                "${workspaceFolder}/ClippyAI/ClippyAI.csproj",
                "/t:CreateRpm",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign",
                "/p:Configuration=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/ClippyAI",
                "env": {
                    "DOTNET_PROCESSOR_COUNT": "1"
                }
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-linux-tar",
            "dependsOn": ["build-release"],
            "command": "dotnet",
            "type": "process",
            "args": [
                "msbuild",
                "${workspaceFolder}/ClippyAI/ClippyAI.csproj",
                "/t:CreateTarball",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign",
                "/p:Configuration=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/ClippyAI",
                "env": {
                    "DOTNET_PROCESSOR_COUNT": "1"
                }
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-linux",
            "dependsOn": ["publish-linux-deb", "publish-linux-rpm", "publish-linux-tar"],
            "dependsOrder": "sequence",
            "command": "bash",
            "type": "process",
            "args": [
                "${workspaceFolder}/scripts/upload-linux-release-assets.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "run",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/ClippyAI/ClippyAI.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/ClippyAI/ClippyAI.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
