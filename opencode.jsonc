{
  // Project configuration for OpenCode (ClippyAI workspace).
  "$schema": "https://opencode.ai/config.json",

  // Enable LSP diagnostics for the agent. Enabling the `lsp` section turns
  // on ALL built-ins, so everything not wanted here is disabled explicitly.
  // csharp: needs .NET SDK (present, 10.0.201). razor: additionally needs
  // the VS Code C# extension (ms-dotnettools.csharp) — currently NOT
  // installed, so razor stays dormant until that extension is added.
  "lsp": {
    "csharp": { "disabled": false },
    "razor": { "disabled": false },
    "clangd": { "disabled": true }
  },

  // Windows GUI testing via winvision-mcp (UIA + WGC + QA asserts).
  // Usage + gotchas: .opencode/skills/win-gui-test/SKILL.md
  // Venv lives on C:\Temp (local disk; %APPDATA% is a slow roaming share).
  // timeout >= 60000: the first cold UIA call can exceed 30 s and a timeout
  // severs the stdio session with no in-session reconnect.
  "mcp": {
    "winvision": {
      "type": "local",
      "command": ["C:\\Temp\\opencode\\winvision-mcp-venv\\Scripts\\python.exe", "-m", "winvision_compatch"],
      "enabled": true,
      "timeout": 60000
    }
  }
}
